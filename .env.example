# PostgreSQL — Docker Compose maps ${POSTGRES_PORT:-5432}:5432
DATABASE_URL="postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public"
# If host already runs Postgres on 5432 (common), set:
# POSTGRES_PORT=5433
# DATABASE_URL="postgresql://marketplace:marketplace@localhost:5433/marketplace?schema=public"

# API
PORT=4000
FRONTEND_URL="http://localhost:5173"
JWT_SECRET="change-me-super-secret-jwt"

# Clerk — preferred auth (https://dashboard.clerk.com → API Keys)
# Get publishable + secret from Clerk Dashboard and set BOTH:
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Frontend (Vite) — must be prefixed with VITE_:
VITE_CLERK_PUBLISHABLE_KEY=""
ADMIN_USERNAME="admin1"
ADMIN_PASSWORD="CircleStore"
ADMIN_SESSION_SECRET="replace-with-a-long-random-value"

# Cloudinary (backend only; never add the API secret to Vite/frontend variables)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Legacy OAuth — now handled via Clerk Dashboard (Google/GitHub/Facebook configured in Clerk)
# Kept for reference if you switch back to Passport:
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GITHUB_CALLBACK_URL="http://localhost:4000/api/auth/github/callback"
# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""
# FACEBOOK_CALLBACK_URL="http://localhost:4000/api/auth/facebook/callback"
