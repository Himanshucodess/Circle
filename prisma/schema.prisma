generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
  RADIO
  CHECKBOX
  MULTI_SELECT
  DATE
}

enum SchemaStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  icon        String?
  status      CategoryStatus    @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  fields       CategoryField[]
  schemas      SchemaVersion[]
  listings     Listing[]
}

model FieldDefinition {
  id          String    @id @default(cuid())
  key         String    @unique
  label       String
  type        FieldType
  description String?
  config      Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categories CategoryField[]
}

model CategoryField {
  id              String    @id @default(cuid())
  categoryId      String
  fieldId         String
  displayOrder    Int       @default(0)
  isRequired      Boolean   @default(false)
  conditionalRule Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  field    FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([categoryId, fieldId])
  @@index([categoryId])
}

model SchemaVersion {
  id           String       @id @default(cuid())
  categoryId   String
  version      Int
  status       SchemaStatus @default(DRAFT)
  schemaJson   Json
  uiSchemaJson Json?
  createdAt    DateTime     @default(now())
  publishedAt  DateTime?

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  listings Listing[]

  @@unique([categoryId, version])
  @@index([categoryId, status])
}

model User {
  id        String   @id @default(cuid())
  clerkId   String?  @unique // Clerk user ID (e.g., user_xxx)
  email     String   @unique
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings Listing[]
  offers   Offer[]
}

model Listing {
  id              String    @id @default(cuid())
  categoryId      String
  schemaVersionId String?
  sellerId        String?
  title           String
  description     String
  price           Float
  condition       String
  location        String
  viewCount       Int       @default(0)
  attributes      Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category  Category      @relation(fields: [categoryId], references: [id])
  schema    SchemaVersion? @relation(fields: [schemaVersionId], references: [id])
  seller    User?          @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  images    ListingImage[]
  offers    Offer[]

  @@index([categoryId])
  @@index([sellerId])
}

model ListingImage {
  id           String  @id @default(cuid())
  listingId    String
  url          String
  displayOrder Int     @default(0)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Offer {
  id        String   @id @default(cuid())
  listingId String
  bidderId  String?
  amount    Int
  message   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidder  User?   @relation(fields: [bidderId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([listingId, status])
  @@index([bidderId])
}
